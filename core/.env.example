# Copy to core/.env (never commit the real file).

# Postgres password for the local compose stack.
POSTGRES_PASSWORD=orbit

# Shared secret between @core/api and Electric. Electric refuses unauthenticated shape requests
# when this is set; only the api knows it. Generate with: openssl rand -hex 32
ELECTRIC_SECRET=change-me

# Development-only bearer tokens, "token:farm-uuid" pairs separated by commas. Leave empty in
# production and issue hashed tokens with `bun core/api/src/cli.ts issue-token <farm-uuid>`.
CORE_STATIC_TOKENS=dev:00000000-0000-4000-8000-00000000f001

# LLM gateway upstream (any OpenAI- or Anthropic-compatible HTTP API).
# Orion calls  POST {CORE}/v1/llm/<provider path>  e.g. /v1/llm/v1/chat/completions.
LLM_UPSTREAM_URL=https://api.openai.com
LLM_UPSTREAM_API_KEY=
# "authorization" (Bearer, OpenAI-style) or "x-api-key" (Anthropic).
LLM_UPSTREAM_AUTH=authorization
# Upstream model Orion gets when it asks for the generic "orbit-default" cloud model.
LLM_DEFAULT_MODEL=gpt-4.1-mini
# Default per-farm monthly token budget (input + output). Per-farm overrides: farm_budgets table.
LLM_MONTHLY_TOKEN_BUDGET=2000000

# Set to "false" to skip running migrations when the api starts.
CORE_MIGRATE_ON_START=true
