# Copy to core/.env (never commit the real file).

# Postgres password for the local compose stack.
POSTGRES_PASSWORD=orbit

# Shared secret between @core/api and Electric. Electric refuses unauthenticated shape requests
# when this is set; only the api knows it. Generate with: openssl rand -hex 32
ELECTRIC_SECRET=change-me

# Development-only bearer tokens, "token:farm-uuid" pairs separated by commas. Leave empty in
# production and issue hashed tokens with `bun core/api/src/cli.ts issue-token <farm-uuid>`.
CORE_STATIC_TOKENS=dev:00000000-0000-4000-8000-00000000f001

# LLM gateway upstream (any OpenAI- or Anthropic-compatible HTTP API).
# Orion calls  POST {CORE}/v1/llm/<provider path>  e.g. /v1/llm/v1/chat/completions.
LLM_UPSTREAM_URL=
LLM_UPSTREAM_API_KEY=
# "authorization" (Bearer, OpenAI-style) or "x-api-key" (Anthropic).
LLM_UPSTREAM_AUTH=google
# Upstream model Orion gets when it asks for the generic "orbit-default" cloud model.
LLM_DEFAULT_MODEL=google/gemini-3.8-flash
GCP_PROJECT=agrointel-dd8f6
# Google auth uses the runtime service identity, a service-account ADC file, or dev gcloud ADC.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
LLM_UPSTREAM_STRIP_PREFIX=/v1
VOICE_MODEL=gemini-3.8-live
VOICE_LOCATION=us-central1

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# "true" only after Stripe Tax is activated (origin address + registrations) in the Stripe account.
STRIPE_AUTOMATIC_TAX=false
# Gets a notice for every paid hardware order.
ORDERS_EMAIL=

# Transactional email (verification, password reset, invites, receipts): "resend", "postmark",
# or "log" to print messages instead of sending (development). Required by src/server.ts.
MAIL_PROVIDER=log
MAIL_API_KEY=
MAIL_FROM=Pecorva <no-reply@agrointel.no>
# Website origin used in email links (/account/?verify=..., ?reset=...) and the Orbit download.
PUBLIC_SITE_URL=http://localhost:3000
ORBIT_DOWNLOAD_URL=https://github.com/kristianvast/orbit/releases/latest
# Version of the terms of service recorded when someone signs up.
TERMS_VERSION=2026-11
BILLING_SUCCESS_URL=http://localhost:3000/account/?billing=success
BILLING_CANCEL_URL=http://localhost:3000/account/?billing=cancel
CORE_CORS_ORIGINS=http://localhost:3000
# Default per-farm monthly token budget (input + output). Per-farm overrides: farm_budgets table.
LLM_MONTHLY_TOKEN_BUDGET=2000000

# Set to "false" to skip running migrations when the api starts.
CORE_MIGRATE_ON_START=true
